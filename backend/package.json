{
  "name": "hotel-hrms-backend",
  "version": "1.0.0",
  "description": "Hotel Employee Management System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
